{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "date": {
            "description": "Document date in ISO format: YYYY-MM-DD",
            "title": "Date",
            "type": "string"
          },
          "forecast_mode": {
            "default": "fast",
            "description": "Forecast mode: fast, quick_train, or real_train",
            "title": "Forecast Mode",
            "type": "string"
          },
          "horizon": {
            "default": "3d",
            "description": "Forecast horizon label",
            "title": "Horizon",
            "type": "string"
          },
          "include_realized": {
            "default": false,
            "description": "When true and date is in the past, include realized forward series overlay.",
            "title": "Include Realized",
            "type": "boolean"
          },
          "symbol": {
            "default": "^GSPC",
            "description": "Market ticker, e.g. ^GSPC or DX-Y.NYB",
            "title": "Symbol",
            "type": "string"
          },
          "text": {
            "description": "FOMC statement text",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "date"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AnalyzeResponse": {
        "properties": {
          "market": {
            "$ref": "#/components/schemas/MarketDataResponse"
          },
          "model": {
            "$ref": "#/components/schemas/ModelDiagnosticsResponse"
          },
          "prediction": {
            "$ref": "#/components/schemas/PredictionResponse"
          },
          "sentiment": {
            "$ref": "#/components/schemas/SentimentResponse"
          },
          "series": {
            "$ref": "#/components/schemas/ForecastSeriesResponse"
          }
        },
        "required": [
          "sentiment",
          "prediction",
          "market",
          "model",
          "series"
        ],
        "title": "AnalyzeResponse",
        "type": "object"
      },
      "ChunkAttentionDiagnostics": {
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "chunk_previews": {
            "items": {
              "type": "string"
            },
            "title": "Chunk Previews",
            "type": "array"
          },
          "decay_coeffs": {
            "items": {
              "type": "number"
            },
            "title": "Decay Coeffs",
            "type": "array"
          },
          "lambda_value": {
            "title": "Lambda Value",
            "type": "number"
          },
          "weights": {
            "items": {
              "type": "number"
            },
            "title": "Weights",
            "type": "array"
          }
        },
        "required": [
          "chunk_count",
          "weights",
          "decay_coeffs",
          "chunk_previews",
          "lambda_value"
        ],
        "title": "ChunkAttentionDiagnostics",
        "type": "object"
      },
      "ForecastSeriesResponse": {
        "properties": {
          "conformal_coverage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Nominal coverage of conformal bands when forecast_band_source='conformal'.",
            "title": "Conformal Coverage"
          },
          "forecast_band_source": {
            "default": "gaussian_z",
            "description": "Source of the forecast bands: 'gaussian_z' (z-score) or 'conformal'.",
            "title": "Forecast Band Source",
            "type": "string"
          },
          "forecast_close": {
            "items": {
              "type": "number"
            },
            "title": "Forecast Close",
            "type": "array"
          },
          "forecast_close_lower": {
            "items": {
              "type": "number"
            },
            "title": "Forecast Close Lower",
            "type": "array"
          },
          "forecast_close_upper": {
            "items": {
              "type": "number"
            },
            "title": "Forecast Close Upper",
            "type": "array"
          },
          "forecast_confidence_level": {
            "title": "Forecast Confidence Level",
            "type": "number"
          },
          "forecast_timestamps": {
            "items": {
              "type": "string"
            },
            "title": "Forecast Timestamps",
            "type": "array"
          },
          "forecast_volatility": {
            "items": {
              "type": "number"
            },
            "title": "Forecast Volatility",
            "type": "array"
          },
          "forecast_volatility_lower": {
            "items": {
              "type": "number"
            },
            "title": "Forecast Volatility Lower",
            "type": "array"
          },
          "forecast_volatility_upper": {
            "items": {
              "type": "number"
            },
            "title": "Forecast Volatility Upper",
            "type": "array"
          },
          "history_close": {
            "items": {
              "type": "number"
            },
            "title": "History Close",
            "type": "array"
          },
          "history_volatility": {
            "items": {
              "type": "number"
            },
            "title": "History Volatility",
            "type": "array"
          },
          "realized_close": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Realized Close"
          },
          "realized_timestamps": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Realized Timestamps"
          },
          "realized_volatility": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Realized Volatility"
          },
          "timestamps": {
            "items": {
              "type": "string"
            },
            "title": "Timestamps",
            "type": "array"
          },
          "volatility_scale": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Volatility Scale",
            "type": "object"
          }
        },
        "required": [
          "timestamps",
          "history_close",
          "history_volatility",
          "forecast_timestamps",
          "forecast_close",
          "forecast_close_lower",
          "forecast_close_upper",
          "forecast_volatility",
          "forecast_volatility_lower",
          "forecast_volatility_upper",
          "forecast_confidence_level",
          "volatility_scale"
        ],
        "title": "ForecastSeriesResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MarketDataResponse": {
        "properties": {
          "close": {
            "title": "Close",
            "type": "number"
          },
          "date_used": {
            "title": "Date Used",
            "type": "string"
          },
          "lookback_days": {
            "title": "Lookback Days",
            "type": "integer"
          },
          "requested_date": {
            "title": "Requested Date",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "volatility_5d": {
            "title": "Volatility 5D",
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "requested_date",
          "date_used",
          "lookback_days",
          "close",
          "volatility_5d"
        ],
        "title": "MarketDataResponse",
        "type": "object"
      },
      "ModelDiagnosticsResponse": {
        "properties": {
          "adaptation_best_epoch": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptation Best Epoch"
          },
          "adaptation_combined_rmse": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptation Combined Rmse"
          },
          "adaptation_epochs_completed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptation Epochs Completed"
          },
          "adaptation_loss": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptation Loss"
          },
          "best_loss": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Best Loss"
          },
          "checkpoint_exists": {
            "title": "Checkpoint Exists",
            "type": "boolean"
          },
          "checkpoint_loaded": {
            "title": "Checkpoint Loaded",
            "type": "boolean"
          },
          "checkpoint_path": {
            "title": "Checkpoint Path",
            "type": "string"
          },
          "chunk_attention": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkAttentionDiagnostics"
              },
              {
                "type": "null"
              }
            ]
          },
          "close_scale": {
            "title": "Close Scale",
            "type": "number"
          },
          "combined_rmse": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Combined Rmse"
          },
          "decay_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decay Rate"
          },
          "dropout": {
            "title": "Dropout",
            "type": "number"
          },
          "head_hidden_size": {
            "title": "Head Hidden Size",
            "type": "integer"
          },
          "hidden_size": {
            "title": "Hidden Size",
            "type": "integer"
          },
          "num_layers": {
            "title": "Num Layers",
            "type": "integer"
          },
          "runtime_mode": {
            "title": "Runtime Mode",
            "type": "string"
          },
          "sequence_length": {
            "title": "Sequence Length",
            "type": "integer"
          }
        },
        "required": [
          "checkpoint_path",
          "checkpoint_exists",
          "checkpoint_loaded",
          "runtime_mode",
          "hidden_size",
          "num_layers",
          "dropout",
          "head_hidden_size",
          "close_scale",
          "sequence_length"
        ],
        "title": "ModelDiagnosticsResponse",
        "type": "object"
      },
      "PredictionResponse": {
        "properties": {
          "close": {
            "title": "Close",
            "type": "number"
          },
          "horizon": {
            "title": "Horizon",
            "type": "string"
          },
          "volatility": {
            "title": "Volatility",
            "type": "number"
          }
        },
        "required": [
          "close",
          "volatility",
          "horizon"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "SentimentResponse": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "raw": {
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Raw",
            "type": "array"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "label",
          "score",
          "raw"
        ],
        "title": "SentimentResponse",
        "type": "object"
      },
      "TrainJobAcceptedResponse": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "status": {
            "default": "queued",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "message"
        ],
        "title": "TrainJobAcceptedResponse",
        "type": "object"
      },
      "TrainJobStatusResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalyzeResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "TrainJobStatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FOMC Sentiment API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analyze": {
      "post": {
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnalyzeResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TrainJobAcceptedResponse"
                    }
                  ],
                  "title": "Response Analyze Analyze Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze"
      }
    },
    "/documents": {
      "get": {
        "operationId": "list_documents_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Documents"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/train-jobs/{job_id}": {
      "get": {
        "operationId": "get_train_job_train_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainJobStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Train Job"
      }
    }
  }
}
