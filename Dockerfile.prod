# Production container for fed-pulse — combines the FastAPI backend and
# the Next.js frontend in a single image and runs both via s6-overlay.
# Caddy lives in its own container in compose.prod.yml so the image
# stays free of reverse-proxy state.
#
# Stage layout:
#   builder-python : Python 3.11 venv at /opt/venv with backend deps,
#                    installed from a hash-pinned ``backend/requirements.lock``.
#   builder-frontend : Node 20, Next.js standalone output for the FE.
#                      Takes NEXT_PUBLIC_API_URL as a build arg so the
#                      browser bundle bakes the production origin.
#   runtime : Python 3.11-slim, copies the venv + standalone bundle,
#             plus s6-overlay to supervise uvicorn and node side by side.
#             Drops to a non-root ``fedpulse`` user before ENTRYPOINT.
#
# The runtime entrypoint (deploy/entrypoint.sh) authenticates against
# HF Hub with $HF_TOKEN, eager-pulls the hot-path artefacts via the
# registry resolver, and then hands off to s6-overlay.

FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS builder-python

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip

# Hash-pinned lockfile guards against a compromised PyPI release between
# the lock-generation moment and any subsequent ``docker compose build``.
# Regenerate with ``make lock`` after a dep bump.
COPY backend/requirements.lock ./
COPY backend/pyproject.toml ./

RUN /opt/venv/bin/pip install --no-cache-dir --require-hashes -r requirements.lock


FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder-frontend

WORKDIR /app

# NEXT_PUBLIC_* env vars are inlined into the client bundle at build
# time; the runtime container can not flip the value. compose.prod.yml
# passes ``NEXT_PUBLIC_API_URL=https://fedpulse.yusufizzetmurat.com``.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci

COPY frontend/ ./

# Standalone output is enabled in next.config.js for the prod build.
# The standalone bundle is self-contained — no node_modules copy needed
# on the runtime side.
RUN npm run build


FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Node + s6-overlay supervise the FE process alongside uvicorn. curl is
# kept in the image so the deploy workflow's smoke test can poke
# /health from inside the container if needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl ca-certificates xz-utils nodejs \
    && rm -rf /var/lib/apt/lists/*

# s6-overlay v3 supervises the two processes. The download URL is pinned
# to a stable release tag and verified against the published sha256 of
# the tarball — TOFU on github.com is otherwise the weak link in the
# image chain.
ARG S6_OVERLAY_VERSION=3.1.6.2
ARG S6_OVERLAY_NOARCH_SHA256=05af2536ec4fb23f087a43ce305f8962512890d7c71572ed88852ab91d1434e3
ARG S6_OVERLAY_X86_64_SHA256=95081f11c56e5a351e9ccab4e70c2b1c3d7d056d82b72502b942762112c03d1c
RUN set -eux; \
    curl -fsSL -o /tmp/s6-noarch.tar.xz \
        "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz"; \
    echo "${S6_OVERLAY_NOARCH_SHA256}  /tmp/s6-noarch.tar.xz" | sha256sum -c -; \
    curl -fsSL -o /tmp/s6-x86_64.tar.xz \
        "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz"; \
    echo "${S6_OVERLAY_X86_64_SHA256}  /tmp/s6-x86_64.tar.xz" | sha256sum -c -; \
    tar -C / -Jxpf /tmp/s6-noarch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-x86_64.tar.xz; \
    rm /tmp/s6-noarch.tar.xz /tmp/s6-x86_64.tar.xz

COPY --from=builder-python /opt/venv /opt/venv

# Non-root runtime user. UID 10001 is high enough to avoid host UID
# collisions on the droplet; primary group stays at GID 0 (root) so
# bind-mounted artefacts written by other containers stay readable.
# /data is the bind-mounted artefact dir, /home/fedpulse/.cache hosts
# the HF cache that compose.prod.yml mounts on a named volume so the
# 2-4 GB encoder bundles survive an image rebuild.
#
# s6-overlay 3.1.6.2's supervisor still needs root to start, but every
# longrun service drops to ``fedpulse`` via ``s6-setuidgid`` before
# exec'ing uvicorn / node. The result: files written into the bind-
# mounted /data volume land under UID 10001 on the host, closing the
# container-escape vector the bare-root layout left open.
RUN useradd --system --uid 10001 --gid 0 --home-dir /home/fedpulse --create-home fedpulse \
    && mkdir -p /data /home/fedpulse/.cache/huggingface \
    && chown -R fedpulse:0 /data /home/fedpulse

# Source copy lands AFTER the pip install so the heavy dep layer stays
# cached across iterative source changes. Without this swap every edit
# under backend/ or scripts/ busts the venv layer and the image rebuild
# pays the full PyPI cost.
COPY backend/ /app/backend/
COPY scripts/ /app/scripts/

# Next.js standalone bundle: server.js + minimal node_modules slice.
# The static / public assets need to land alongside the server output.
COPY --from=builder-frontend /app/.next/standalone /app/frontend/
COPY --from=builder-frontend /app/.next/static /app/frontend/.next/static
COPY --from=builder-frontend /app/public /app/frontend/public

COPY deploy/entrypoint.sh /entrypoint.sh
COPY deploy/s6-services /etc/s6-overlay/s6-rc.d
RUN chmod +x /entrypoint.sh \
    && chown -R fedpulse:0 /app /etc/s6-overlay /entrypoint.sh

ENV PYTHONPATH=/app/backend \
    FED_PULSE_DATA_DIR=/data \
    HF_HOME=/home/fedpulse/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/home/fedpulse/.cache/huggingface

EXPOSE 8000 3000

# s6-overlay 3.1.6.2's /init needs to start as root so it can lay down
# /run, /var/run, and the supervisor tree. Per-service ``run`` scripts
# step down to UID 10001 via ``s6-setuidgid fedpulse`` before exec'ing
# the actual workload, so neither uvicorn nor node ever runs as root.
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/init"]
