# Copy this file to .env and fill in the values. .env is gitignored.

# Hugging Face access token (required for gated checkpoints and higher rate limits).
# Get one at https://huggingface.co/settings/tokens with 'read' scope.
HF_TOKEN=

# Optional: alias the same token under the older env name if some tooling reads it.
# HUGGINGFACE_HUB_TOKEN=

# Kaggle API credentials (required for --include-kaggle ingestion).
# Get from https://www.kaggle.com/settings -> "Create New API Token". Open the
# downloaded kaggle.json and copy the two fields here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Gemini API key for the LLM-as-judge pseudo-labelling annotator and the
# stronger LLM zero-shot baseline rerun (Plan 4 / #37, Plan ~/#38). Free
# tier covers ~10k inferences. Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# LangSmith API key for tracing LLM calls and managing audit datasets +
# auto-evaluators (Plan 4 / #42). Free tier covers tracing and small
# datasets. Sign up at https://smith.langchain.com/ -> Settings -> API Keys.
LANGSMITH_API_KEY=
